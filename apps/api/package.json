{
  "name": "@jarvis/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm db:migrate && tsx watch --conditions=development src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:generate": "NODE_OPTIONS=--conditions=development drizzle-kit generate",
    "db:migrate": "tsx --conditions=development src/db/migrate.ts",
    "db:seed": "tsx --conditions=development src/db/seed.ts",
    "db:sample": "tsx --conditions=development src/db/sample.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.3",
    "@jarvis/schemas": "workspace:*",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fastify-type-provider-zod": "^7.0.0",
    "postgres": "^4.1.0",
    "zod": "^4.6.7"
  }
}
