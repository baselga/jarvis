# Copia este archivo a `.env` y cambia los valores.

# Postgres (los usa el contenedor de la BD y Compose para montar DATABASE_URL)
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=jarvis

# API
LOG_LEVEL=info

# Tests
# Se usa desde el host (en el contenedor la define Compose). El nombre de la BD
# debe terminar en `_test`: los tests la vacían y la crean si no existe.
TEST_DATABASE_URL=postgres://jarvis:cambia-esto@localhost:5432/jarvis_test
